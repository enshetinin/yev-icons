{
  "name": "yev-icons",
  "version": "1.0.0",
  "description": "Yev's personal icon set: 24×24 grid, 1.5 stroke, currentColor.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/react/index.js",
  "types": "./dist/react/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./icons.json": "./dist/icons.json",
    "./sprite.svg": "./dist/sprite.svg",
    "./svg/*": "./dist/svg/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "npm run build && open dist/preview.html"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "svgo": "^4.0.0"
  }
}
